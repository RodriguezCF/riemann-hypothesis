        apply card_lt_card
        rw [ssubset_iff_of_subset]
        · exact ⟨a + m, by simp [hP], by simp⟩
        · exact filter_subset_filter _ (range_mono (by omega))
      omega
    push_neg at h5
    have e : a + (m + 1) = a + m + 1 := rfl
    rw [e]
    push_cast
    linarith

