    have h1 : τ (H.rt : E) = H.rt0 := h
    have h2 : starRingEnd ℂ (τ (H.rt : E)) = H.rt0 := h'
    rw [h2, h1]
  have e3 : τ (H.rt : E) ^ 2 = -(H.d : ℂ) := by
    have := congrArg (fun z : 𝓞 E => τ (z : E)) H.rt_sq
