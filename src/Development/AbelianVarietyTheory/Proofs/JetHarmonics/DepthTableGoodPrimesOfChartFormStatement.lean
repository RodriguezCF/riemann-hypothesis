      show ((wtA (lR Tp hK j) (DV.tauEmb D (plOf D z), D.R.k - 2) -
        wtA (lR Tp hK j) (DV.tauEmb D (plOf D z), D.R.k - 1) : ℕ) : ℝ) = _
