  have hprod : ∏ i ∈ Finset.range h, r i = π ^ 12 := by
    rw [htel, disc_of_mul L (M h) π hπ0 hMh, hM0]
    field_simp [disc_ne_zero L]
  have hnorm : ∏ i ∈ Finset.range h, ‖ι (r i)‖ = 1 := by
    rw [← norm_prod, ← map_prod, hprod, map_pow, norm_pow, hπ1, one_pow]
