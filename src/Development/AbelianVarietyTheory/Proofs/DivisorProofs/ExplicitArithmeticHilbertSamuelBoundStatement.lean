def RatPt.geomPt (x : RatPt (G.baseChange E) s) : (G.toLinSys.baseChange E).Pt (AlgebraicClosure E) :=
  Points.PtsOver.map ((G.baseChange E).ideal s).subschemeι rfl _ (x.along (algebraMap E (AlgebraicClosure E)))

