    rw [e1, Scheme.Hom.image_preimage_eq_opensRange_inf, hφr, ← Scheme.Hom.preimage_inf, inf_eq_right.2 hWr]
  · intro i y hy
    obtain ⟨x, hx, rfl⟩ := hy
