    _ = _ := by rw [← Matrix.mul_assoc, mat_inv_mul, Matrix.one_mul]


omit [Valued L (WithZero (Multiplicative ℤ))] in
theorem mat_zpow_diag {ϖ : L} (hϖ : ϖ ≠ 0) {s : GU σ r} {b : Fin r → ℤ}
    (hs : mat s = Matrix.diagonal (fun i => ϖ ^ b i)) (d : ℤ) :
