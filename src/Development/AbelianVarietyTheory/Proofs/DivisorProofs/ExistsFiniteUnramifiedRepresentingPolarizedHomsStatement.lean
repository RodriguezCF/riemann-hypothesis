      rotate_left 3
      refine LBIso.trans (B := (M.pull R.φB).pull ((u ≫ pA) ≫ R.Φ.left)) ?_ ?_ ?_
        (GlobalTheory.OriginCohom.lbIso_pull_pull_comp hm _ _) ?_
