        (GlobalTheory.OriginCohom.lbIso_pull_pull_comp hm _ _) ?_
      rotate_left 3
      refine LBIso.trans (B := M.pull ((pA ≫ R.Φ.left) ≫ R.φB)) ?_ ?_ ?_
        (GlobalTheory.OriginCohom.lbIso_pull_pull_comp hM _ _) ?_
      rotate_left 3
