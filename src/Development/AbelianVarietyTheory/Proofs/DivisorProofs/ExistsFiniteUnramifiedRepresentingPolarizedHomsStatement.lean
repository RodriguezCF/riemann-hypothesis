    have hKA : IsGrpPullback AK A (x ≫ R.π) (pA ≫ R.φA) := hK1A.comp R.pbA
    have hKA' : IsGrpPullback AK A (Out.jK V ≫ y) (pA ≫ R.φA) := hKA.congr hxy rfl
