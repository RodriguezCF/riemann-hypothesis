        (GlobalTheory.OriginCohom.lbIso_pull_pull_comp hM _ _) ?_
      rotate_left 3
      refine LBIso.trans (B := M.pull (((u ≫ κA) ≫ ΦV.left) ≫ ψB)) ?_ ?_ ?_
        (lbIso_pull_eq hM eqM) ?_
      rotate_left 3
      refine LBIso.symm (LBIso.trans (B := (M.pull ψB).pull ((u ≫ κA) ≫ ΦV.left)) ?_ ?_ ?_
