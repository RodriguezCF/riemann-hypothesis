      spMap π ≫ (Spec.map (CommRingCat.ofHom β) ≫ hU.fromSpec) := by
    rw [Category.assoc, ← hA, ← Category.assoc, ← Spec.map_comp, ← Category.assoc, spMap,
      ← Spec.map_comp]
    congr 2
    ext1
    exact hcomp
