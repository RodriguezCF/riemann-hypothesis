    rw [hk, Ideal.mem_bot] at h2
    exact one_ne_zero h2
  have hsub : ∀ a b : PrimeSpectrum C, a = b := by
    intro a b
    ext1
    rw [IsLocalRing.eq_maximalIdeal (IsArtinianRing.isMaximal_of_isPrime a.asIdeal),
