        intro y hy y' hy' hyy
        by_contra hcon
        push Not at hcon
        apply hyy
        have hm := hdist y.out (hout y hy) y'.out (hout y' hy') (fun u hu => hcon ⟨u, hu⟩)
        rw [← QuotientAddGroup.out_eq' y, ← QuotientAddGroup.out_eq' y', QuotientAddGroup.eq_iff_sub_mem]
