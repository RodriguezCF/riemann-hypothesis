    have : _root_.IsReduced A := (affine_isReduced_iff (CommRingCat.of A)).1 this
    have e₁ : a' ≫ x i' ≫ s = a ≫ x i ≫ s := by rw [← Category.assoc, ← e, Category.assoc]
    generalize hs' : a ≫ x i ≫ s = s' at u e₁ hu₁
    obtain ⟨β, rfl⟩ := exists_spMap s'
