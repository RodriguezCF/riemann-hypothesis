    refine (tcomp hu' (Category.id_comp _)).1
      (T.thetaLevel_iso_unique_of_dense_common_fibres h₁ h₂ o g N' J b m A β u u' hm hm' ho (Dense.mono (fun p _ => ?_) dense_univ)).1
    obtain ⟨K, _, _, y, hy⟩ := exists_geomPt p
