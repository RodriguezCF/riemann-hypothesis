    have hadmT : admitted N l (Letter.T q) := ⟨hq, hndvd⟩
    have hadmD : admitted N l (Letter.D q) :=
      (Nat.Prime.coprime_iff_not_dvd hq).2 (fun h => hndvd (Dvd.dvd.mul_right h l))
    obtain ⟨htq, hdq⟩ := hfr q hq hq0 σ hσ
