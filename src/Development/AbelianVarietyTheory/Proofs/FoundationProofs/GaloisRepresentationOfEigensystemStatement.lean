    obtain ⟨S1, hS1⟩ := hes m
    refine ⟨S1 ∪ S0 ∪ (N * l).primeFactors, fun q hq hqS σ hσ => ?_⟩
    simp only [Finset.mem_union, not_or, Nat.mem_primeFactors] at hqS
    obtain ⟨⟨hq1, hq0⟩, hq2⟩ := hqS
    have hNl0 : N * l ≠ 0 := Nat.mul_ne_zero (by omega) (Fact.out : l.Prime).ne_zero
