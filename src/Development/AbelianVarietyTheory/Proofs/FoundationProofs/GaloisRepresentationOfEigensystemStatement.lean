    refine ⟨Finset.univ.biUnion E0, fun s' hs' i j => ?_⟩
    have hfix : ∀ x ∈ E0 j, s' x = x := fun x hx => hs' x (Finset.mem_biUnion.2 ⟨j, Finset.mem_univ _, hx⟩)
    refine hm (fun i => (A s' - 1) i j) ?_ i
