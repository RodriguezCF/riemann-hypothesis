    intro i
    unfold reps
    split_ifs with hi
    · simp
    · obtain ⟨s01, s10, s11⟩ := hσ
      have hd : (σ : Matrix (Fin 2) (Fin 2) ℤ).det = 1 := σ.2
      rw [Matrix.det_fin_two] at hd
      have hd' := congrArg (fun x : ℤ => (x : ZMod M)) hd
