      (-1 : ℝ) • ∑ k, (a k : ℝ) * Real.log (⨆ i, v (w ⟨k, i⟩)) := fun v => by
    rw [smul_eq_mul, Finset.mul_sum]
    refine Finset.sum_congr rfl fun k _ => ?_
    simp only [Pi.neg_apply]
    push_cast
    ring
  simp only [ptHt, e]
  rw [← smul_finsum, Finset.sum_neg_distrib, smul_eq_mul]
  ring

