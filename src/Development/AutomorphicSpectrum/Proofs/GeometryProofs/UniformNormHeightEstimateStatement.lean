    rw [← Real.exp_add, sub_eq_add_neg]
  refine ⟨Real.exp 1 * Real.exp (-v), by positivity, lt_of_lt_of_le hv2 (min_le_left _ _),
    lt_of_lt_of_le hv2 (min_le_right _ _), ?_⟩
