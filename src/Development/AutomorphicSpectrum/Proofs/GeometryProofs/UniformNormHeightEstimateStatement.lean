      _ ≤ |cf r| * (Bf r + |Sys.C₅| * L) := mul_le_mul_of_nonneg_left h3 (abs_nonneg _)
  exact le_exp_mul_pow_of_log_le (Finset.prod_pos fun r _ => zpow_pos ((Or.sing r).pos _ hwT) _)
    hr1 (Nat.le_ceil _) hle

