  obtain ⟨v, rfl⟩ := (LiePull.tanPts h x').surjective u
  exact ⟨v, rfl, (LiePull.isTan_iff h x' v).1⟩

theorem hodge_congr {S : Scheme.{0}} {G : Over S} [GrpObj G] (Lb : LB G.left) {z z' : Sp ℂ ⟶ S} (h : z = z')
