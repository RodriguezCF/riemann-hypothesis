    (hvar : GlobalTheory.IsArithVar (j ≫ qpStr n' m n) e) :
    topologicalKrullDim (closure ({j (genericPoint Y)} : Set (MP ℤ (m + 1) (consN n' n)))) = ((e + 1 : ℕ) : _) := by
