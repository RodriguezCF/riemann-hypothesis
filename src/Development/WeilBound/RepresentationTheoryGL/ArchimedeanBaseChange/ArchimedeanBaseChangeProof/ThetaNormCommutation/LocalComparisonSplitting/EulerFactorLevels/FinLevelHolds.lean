    (h₁ : IsHecke L f₁) (h₂ : IsHecke L f₂) (hG : Good (MonoidHom.id H) K N)
    (hprop : ∀ C : Set H, IsCompact C → ∃ D : Set H, IsCompact D ∧ ∀ x : H, x⁻¹ * N * x ∈ C →
      ∃ t ∈ twCent (MonoidHom.id H) N, ∃ d ∈ D, x = t * d)
