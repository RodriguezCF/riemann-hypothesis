  have hle : ∀ x : H, twCent (MonoidHom.id H) N ⊓ L.map (MulAut.conj x).toMonoidHom ≤
      cptPart (twCent (MonoidHom.id H) N) := fun x =>
    le_trans (inf_le_inf_left _ (Subgroup.map_mono hLK)) (hZK x)
