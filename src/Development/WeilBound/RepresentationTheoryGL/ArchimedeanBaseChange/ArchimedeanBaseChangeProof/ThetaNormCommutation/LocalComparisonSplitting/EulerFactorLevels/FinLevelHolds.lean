  have hconv := GlobalTheory.T.hecke_convolution_support H K L f₁ f₂ hLK hidx h₁ h₂
  obtain ⟨B1, B2⟩ := GlobalTheory.T.twistedOrbitalIntegral_eq_sum_smallerLevel H (MonoidHom.id H) K hKo hKc (fun k hk => hk) L
