  · rintro ⟨k₁, k₂⟩ ⟨hk₁, hk₂⟩ ⟨x, y⟩
    simp only [hf, Prod.mk_mul_mk]
    rw [(h₁.2 _ hk₁ _).1, (h₂.2 _ hk₂ _).1, (h₁.2 _ hk₁ _).2, (h₂.2 _ hk₂ _).2]
    exact ⟨rfl, rfl⟩

