  obtain ⟨x, hxr, hxg⟩ := hx
  have hCM : HeckeCharacterZeroLocus.SiegelWeilU.IsCMExt D.host.F D.host.E D.sp.cm.sig := Formalism.MainNotions.UnusedSlot34.isCMExt_D D
