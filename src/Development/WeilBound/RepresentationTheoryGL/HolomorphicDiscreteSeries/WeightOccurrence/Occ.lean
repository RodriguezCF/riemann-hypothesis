    (hg : Formalism.QuantumDeterminants.GapAtLeast ε lam (200 * ((2 * r + k + 1 : ℕ) : ℝ) ^ 3)) :
    ∃ X : Dec ε lam π, X.S = univ.filter (fun s => IsHCParam (shift true lam s)) ∧
      ∀ s, X.κ s = (lam s : ℂ) + (((2 * r + k + 1 : ℕ) : ℂ) - 1) / 2 := by
