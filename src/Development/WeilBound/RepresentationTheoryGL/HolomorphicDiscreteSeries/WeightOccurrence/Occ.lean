theorem hs_emb (M : Matrix (Fin n) (Fin n) ℂ) : hs (emb e M) = hs M + 1 := by
  unfold hs emb
  simp only [Matrix.reindex_apply, Matrix.submatrix_apply]
  rw [← Equiv.sum_comp e]
  simp only [Equiv.symm_apply_apply]
