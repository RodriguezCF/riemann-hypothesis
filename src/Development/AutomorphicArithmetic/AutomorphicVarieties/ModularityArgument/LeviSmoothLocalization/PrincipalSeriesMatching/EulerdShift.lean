      rw [k1, hu _ ((mem_int_one g.1).1 g.2)]; simp, hv⟩
    obtain ⟨w, hw, hw0⟩ := (Submodule.ne_bot_iff _).1 (UpperTheory.fixed_ne_bot_of_isSubquotient_of_isCompact _ _ _ _ _ _ hρ hy
