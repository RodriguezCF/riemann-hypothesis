private theorem mem_int_one (g : GL (Fin 1) k) :
    g ∈ integralGL k 1 ↔ valuation k ((Matrix.GeneralLinearGroup.det g : kˣ) : k) = 1 := by
  have h1 : ((Matrix.GeneralLinearGroup.det g : kˣ) : k) = g 0 0 := by simp [Matrix.det_unique]
