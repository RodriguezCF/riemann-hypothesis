  · rintro c' ⟨u', hu', rfl⟩
    obtain ⟨u, hu, e1⟩ := hL u' hu'
    have e0 : t (f (u * h)) = f (u' * h') := by
      have : f (u * h) = t (f (u' * h')) := by simp only [map_mul, e1, hh']
      rw [this, ht]
    refine ⟨QuotientGroup.mk (u * h), ⟨u, hu, rfl⟩, ?_⟩
