    obtain ⟨g', e, -⟩ := key c hc
    obtain ⟨l, hl, e2⟩ := dec g' (m c) (hm c _ e)
    obtain ⟨l', hl', e3⟩ := hL l hl
    rw [e2, map_mul, map_mul, map_mul, ht, ← e, ht, e3, ← mul_assoc, hψ _ hl']

end SlopeTestRemainingChoices

